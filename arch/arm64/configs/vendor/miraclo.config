#
# MiraCLO kernel options for marble
#

# Base kernel: KernelSU stays off, as in Beta 1 (root builds turn it on)
CONFIG_KSU=m
CONFIG_MODULE_SCMVERSION=n

# Kernel name: 5.10.x-aurora-..., without the -gki suffix
CONFIG_LOCALVERSION=""

# Network: BBR congestion control by default
CONFIG_DEFAULT_WESTWOOD=n
CONFIG_DEFAULT_BBR=y
